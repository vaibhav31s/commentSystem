# Copy to .env (next to docker-compose.yml) and set your own values. Never commit .env.
MYSQL_ROOT_PASSWORD=<choose-a-root-password>
DB_NAME=slimphp
DB_USER=vaibhav
DB_PASSWORD=<choose-a-db-password>
# Frontend origins allowed to call the API (comma separated; localhost is always allowed)
CORS_ORIGINS=https://comments.vaibhavgawad.com,https://kartavyapath.xyz,https://www.kartavyapath.xyz,https://comment-system-eight.vercel.app
# Secret that signs login tokens (generate: python3 -c "import secrets;print(secrets.token_urlsafe(48))")
JWT_SECRET=<long-random-secret>
