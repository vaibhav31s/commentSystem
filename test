version: '3'
services:
    web:
        build:
            context: Backend
            dockerfile: nginx.Dockerfile
        image: nginx
        ports:
            - "8888:80"
        depends_on:
            - php
        restart: always
    frontend:
        image: vaibhavgawad/codechef-frontend:latest
        ports:
            - "8081:80"
    php:
        build:
            context: Backend
            dockerfile: dev.Dockerfile
        environment:
            DB_HOST: mysql
            DB_NAME: ${DB_NAME:-slimphp}
            DB_USER: ${DB_USER:-vaibhav}
            DB_PASSWORD: ${DB_PASSWORD:?DB_PASSWORD must be set}
        depends_on:
            - mysql
        restart: always
    mysql:
        image: mariadb
        environment:
            MYSQL_ROOT_PASSWORD: ${MYSQL_ROOT_PASSWORD:?MYSQL_ROOT_PASSWORD must be set}
            MYSQL_USER: ${DB_USER:-vaibhav}
            MYSQL_PASSWORD: ${DB_PASSWORD:?DB_PASSWORD must be set}
            MYSQL_DATABASE: ${DB_NAME:-slimphp}
        volumes:
            - slimphp:/var/lib/mysql
        ports:
            - "3325:3306"
        restart: always
    
volumes:
   slimphp: {}
   